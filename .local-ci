#!/usr/bin/env bash
# The checks every change must pass, run on this machine by `local-ci` (claude-toolkit)
# in place of GitHub Actions. Run it directly to check without posting a status.
# Builds every deck from its source, so a broken source file, build script or missing
# audio clip fails here. The built .apkg files are git-ignored.
set -euo pipefail
cd "$(dirname "$0")"
# Decks name their audio clips with the Psittacus submodule's code.
git submodule update --init -q addons/psittacus

for build in decks/*/build.py; do
  echo; echo "== $(dirname "$build")"
  uv run --no-project -q -p 3.13 --with genanki==0.13.1 python "$build"
done
